Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "\:7b2c\:516b\:9898", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Clear", "[", "\"\<`*\>\"", "]"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"f1", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"y", "''"}], "[", "t", "]"}], "+", 
      RowBox[{"2", 
       RowBox[{
        RowBox[{"y", "'"}], "[", "t", "]"}]}], "+", 
      RowBox[{"3", 
       RowBox[{"y", "[", "t", "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"f2", "=", 
     RowBox[{"3", 
      RowBox[{"Cos", "[", "t", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"F1", "=", 
     RowBox[{"LaplaceTransform", "[", 
      RowBox[{"f1", ",", "t", ",", "s"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"F2", "=", 
     RowBox[{"LaplaceTransform", "[", 
      RowBox[{"f2", ",", "t", ",", "s"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"sol", "=", 
     RowBox[{
      RowBox[{"Solve", "[", 
       RowBox[{
        RowBox[{"F1", "==", "F2"}], ",", 
        RowBox[{"LaplaceTransform", "[", 
         RowBox[{
          RowBox[{"y", "[", "t", "]"}], ",", "t", ",", "s"}], "]"}]}], "]"}], 
      "/.", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"y", "[", "0", "]"}], "->", "0"}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"y", "'"}], "[", "0", "]"}], "->", "1"}]}], "}"}]}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{"InverseLaplaceTransform", "[", 
    RowBox[{"sol", ",", "s", ",", "t"}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.894329179628068*^9, 3.8943292371842318`*^9}, {
  3.894329269304463*^9, 3.8943293208553333`*^9}, {3.894329358592462*^9, 
  3.894329473434499*^9}},
 CellLabel->
  "In[292]:=",ExpressionUUID->"ef3dcd9f-9ac5-4090-adf3-d10847cff840"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"y", "[", "t", "]"}], "\[Rule]", 
    RowBox[{
     RowBox[{
      FractionBox["3", "4"], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Cos", "[", "t", "]"}], "+", 
        RowBox[{"Sin", "[", "t", "]"}]}], ")"}]}], "-", 
     RowBox[{
      FractionBox["1", "4"], " ", 
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{"-", "t"}]], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"3", " ", 
         RowBox[{"Cos", "[", 
          RowBox[{
           SqrtBox["2"], " ", "t"}], "]"}]}], "+", 
        RowBox[{
         SqrtBox["2"], " ", 
         RowBox[{"Sin", "[", 
          RowBox[{
           SqrtBox["2"], " ", "t"}], "]"}]}]}], ")"}]}]}]}], "}"}], 
  "}"}]], "Output",
 CellChangeTimes->{
  3.8943294185234613`*^9, {3.8943294520425043`*^9, 3.8943294743784633`*^9}},
 CellLabel->
  "Out[298]=",ExpressionUUID->"6b614d3f-c02f-4c0f-a107-ee35182010ae"]
}, Open  ]],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "\:7b2c\:4e5d\:9898", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Clear", "[", "\"\<`*\>\"", "]"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"f1", "=", 
     RowBox[{"TriangleWave", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", "2"}], "}"}], ",", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"x", "-", 
          RowBox[{"1", "/", "2"}]}], ")"}], "/", "2"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"F1", "=", 
     RowBox[{"FourierSeries", "[", 
      RowBox[{"f1", ",", "x", ",", "1"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"F5", "=", 
     RowBox[{"FourierSeries", "[", 
      RowBox[{"f1", ",", "x", ",", "5"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"F9", "=", 
     RowBox[{"FourierSeries", "[", 
      RowBox[{"f1", ",", "x", ",", "9"}], "]"}]}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.894329478957464*^9, 3.8943296091594653`*^9}, {
