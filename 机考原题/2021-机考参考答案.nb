    RowBox[{
     RowBox[{"F1", "[", "s_", "]"}], ":=", 
     FractionBox[
      RowBox[{
       RowBox[{"s", "^", "2"}], "+", "8"}], 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"s", "^", "2"}], "+", 
         RowBox[{"5", "*", "s"}], "+", "6"}], ")"}], "*", 
       RowBox[{"(", 
        RowBox[{"s", "+", "12"}], ")"}]}]]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"F2", "[", "s_", "]"}], ":=", 
     FractionBox["2", 
      RowBox[{
       RowBox[{"s", "^", "3"}], "*", 
       RowBox[{"(", 
