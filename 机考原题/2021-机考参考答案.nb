   FontSize->24], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Clear", "[", "\"\<`*\>\"", "]"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"f1", "[", "t_", "]"}], ":=", 
     RowBox[{"2", "*", 
      RowBox[{"UnitStep", "[", "t", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"f2", "[", "t_", "]"}], ":=", 
     RowBox[{
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{"-", "2"}], "*", "t"}], "]"}], "*", 
      RowBox[{"UnitStep", "[", "t", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"Conv", "=", 
    RowBox[{"Convolve", "[", 
     RowBox[{
      RowBox[{"f1", "[", "t", "]"}], ",", 
      RowBox[{"f2", "[", "t", "]"}], ",", "t", ",", "s"}], "]"}]}], 
   "\[IndentingNewLine]", 
   RowBox[{"Plot", "[", 
    RowBox[{"Conv", ",", 
     RowBox[{"{", 
