        RowBox[{"u", "[", 
         RowBox[{"x", ",", "0"}], "]"}], "\[Equal]", 
        RowBox[{
         RowBox[{"Exp", "[", 
          RowBox[{"-", 
           RowBox[{"x", "^", "2"}]}], "]"}], "*", 
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"-", "I"}], "*", "p", "*", 
           RowBox[{"x", "^", "2"}]}], "]"}]}]}]}], "}"}], ",", 
