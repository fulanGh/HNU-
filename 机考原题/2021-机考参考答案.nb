    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"I", "*", 
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{"u", "[", 
             RowBox[{"x", ",", "z"}], "]"}], ",", "z"}], "]"}]}], "+", 
         RowBox[{"0.5", "*", 
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{"u", "[", 
