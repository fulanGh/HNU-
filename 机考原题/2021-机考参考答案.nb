Cell[BoxData[
 StyleBox[
  RowBox[{"\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Clear", "[", "\"\<`*\>\"", "]"}], "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"p", "=", "1"}], ";"}], "\[IndentingNewLine]", 
    RowBox[{"solution", "=", 
     RowBox[{"NDSolve", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"I", "*", 
            RowBox[{"D", "[", 
             RowBox[{
              RowBox[{"u", "[", 
               RowBox[{"x", ",", "z"}], "]"}], ",", "z"}], "]"}]}], "+", 
           RowBox[{"0.5", "*", 
            RowBox[{"D", "[", 
             RowBox[{
              RowBox[{"u", "[", 
               RowBox[{"x", ",", "z"}], "]"}], ",", "x", ",", "x"}], 
             "]"}]}]}], "\[Equal]", "0"}], ",", 
         RowBox[{
          RowBox[{"u", "[", 
           RowBox[{"x", ",", "0"}], "]"}], "\[Equal]", 
          RowBox[{
           RowBox[{"Exp", "[", 
            RowBox[{"-", 
             RowBox[{"x", "^", "2"}]}], "]"}], "*", 
           RowBox[{"Exp", "[", 
            RowBox[{
             RowBox[{"-", "I"}], "*", "p", "*", 
             RowBox[{"x", "^", "2"}]}], "]"}]}]}]}], "}"}], ",", 
       RowBox[{"u", "[", 
        RowBox[{"x", ",", "z"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", 
         RowBox[{"-", "10"}], ",", "10"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"z", ",", "0", ",", "3"}], "}"}]}], "]"}]}], 
    "\[IndentingNewLine]", 
    RowBox[{"Plot3D", "[", 
     RowBox[{
      RowBox[{"Evaluate", "[", 
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{"u", "[", 
          RowBox[{"x", ",", "z"}], "]"}], "]"}], "/.", 
        RowBox[{"First", "[", "solution", "]"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", 
        RowBox[{"-", "10"}], ",", "10"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"z", ",", "0", ",", "3"}], "}"}], ",", 
      RowBox[{"PlotRange", "\[Rule]", "Full"}]}], "]"}]}]}],
