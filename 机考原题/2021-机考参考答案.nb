       RowBox[{"-", "10"}], ",", "10"}], "}"}]}], "]"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"g1", "=", 
     RowBox[{"FourierTransform", "[", 
      RowBox[{
       RowBox[{"f1", "[", "t", "]"}], ",", "t", ",", "w"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"g2", "=", 
     RowBox[{"FourierTransform", "[", 
      RowBox[{
       RowBox[{"f2", "[", "t", "]"}], ",", "t", ",", "w"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"G", "=", 
    RowBox[{"g1", "*", "g2"}]}], "\[IndentingNewLine]", 
