Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "4", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Clear", "[", "\"\<`*\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"F1", "[", "\[Omega]_", "]"}], ":=", 
     RowBox[{
      FractionBox[
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{"-", 
         FractionBox[
          SuperscriptBox["\[Omega]", "2"], 
          RowBox[{"4", " ", "1"}]]}]], 
       RowBox[{
        SqrtBox["2"], " ", 
        SqrtBox["1"]}]], " ", 
      RowBox[{"UnitBox", "[", 
       FractionBox["\[Omega]", "1"], "]"}]}]}], 
    RowBox[{"(*", 
     RowBox[{"a", "==", "1"}], "*)"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"F2", "[", "\[Omega]_", "]"}], ":=", 
     RowBox[{
      FractionBox[
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{"-", 
         FractionBox[
          SuperscriptBox["\[Omega]", "2"], 
          RowBox[{"4", " ", "4"}]]}]], 
       RowBox[{
        SqrtBox["2"], " ", 
        SqrtBox["4"]}]], " ", 
      RowBox[{"UnitBox", "[", 
       FractionBox["\[Omega]", "4"], "]"}]}]}], 
    RowBox[{"(*", 
     RowBox[{"a", "==", "4"}], "*)"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"F3", "[", "\[Omega]_", "]"}], ":=", 
     RowBox[{
      FractionBox[
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{"-", 
         FractionBox[
          SuperscriptBox["\[Omega]", "2"], 
          RowBox[{"4", " ", "9"}]]}]], 
       RowBox[{
        SqrtBox["2"], " ", 
