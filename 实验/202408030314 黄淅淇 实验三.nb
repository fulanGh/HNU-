Cell[BoxData[{
 RowBox[{
  RowBox[{"h6", "[", "t_", "]"}], "=", 
  RowBox[{"InverseLaplaceTransform", "[", 
   RowBox[{
    RowBox[{"H6", "[", "s", "]"}], ",", "s", ",", "t"}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"c61", "=", 
  RowBox[{"Convolve", "[", 
   RowBox[{
    RowBox[{"h6", "[", "t", "]"}], ",", 
    RowBox[{"DiracDelta", "[", "t", "]"}], ",", "t", ",", "x"}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"c62", "=", 
  RowBox[{"Convolve", "[", 
   RowBox[{
    RowBox[{"h6", "[", "t", "]"}], ",", 
    RowBox[{"UnitStep", "[", "t", "]"}], ",", "t", ",", "x"}], 
   "]"}]}], "\[IndentingNewLine]", 
