Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"h2", "[", "t_", "]"}], "=", 
  RowBox[{"InverseLaplaceTransform", "[", 
   RowBox[{
    RowBox[{"H2", "[", "s", "]"}], ",", "s", ",", "t"}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"c21", "=", 
  RowBox[{"Convolve", "[", 
   RowBox[{
    RowBox[{"h2", "[", "t", "]"}], ",", 
    RowBox[{"DiracDelta", "[", "t", "]"}], ",", "t", ",", "x"}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"c22", "=", 
  RowBox[{"Convolve", "[", 
   RowBox[{
    RowBox[{"h2", "[", "t", "]"}], ",", 
    RowBox[{"UnitStep", "[", "t", "]"}], ",", "t", ",", "x"}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"c21", ",", "c22"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"-", "9"}], ",", "9"}], "}"}]}], "]"}]}], "Input",
