Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"h4", "[", "t_", "]"}], "=", 
  RowBox[{"InverseLaplaceTransform", "[", 
   RowBox[{
    RowBox[{"H4", "[", "s", "]"}], ",", "s", ",", "t"}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"c41", "=", 
  RowBox[{"Convolve", "[", 
   RowBox[{
    RowBox[{"h4", "[", "t", "]"}], ",", 
    RowBox[{"DiracDelta", "[", "t", "]"}], ",", "t", ",", "x"}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"c42", "=", 
  RowBox[{"Convolve", "[", 
   RowBox[{
    RowBox[{"h4", "[", "t", "]"}], ",", 
    RowBox[{"UnitStep", "[", "t", "]"}], ",", "t", ",", "x"}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"c41", ",", "c42"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"-", "9"}], ",", "9"}], "}"}]}], "]"}]}], "Input",
