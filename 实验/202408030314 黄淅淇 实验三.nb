   RowBox[{"f1", "=", 
    RowBox[{"InverseFourierTransform", "[", 
     RowBox[{
      RowBox[{"F1", "[", "\[Omega]", "]"}], ",", "\[Omega]", ",", "t"}], 
     "]"}]}], "\[IndentingNewLine]", 
