Cell[BoxData[{
 RowBox[{
  RowBox[{"H3", "[", "s_", "]"}], ":=", 
  RowBox[{"1", "/", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"s", "^", "2"}], "+", "16"}], ")"}]}]}], "\[IndentingNewLine]", 
 RowBox[{"Solve", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"s", "^", "2"}], "+", "16"}], "==", "0"}], ",", "s"}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{"ListPlot", "[", 
  RowBox[{
   RowBox[{"ReIm", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "4"}], "I"}], ",", 
      RowBox[{"4", "I"}]}], "}"}], "]"}], ",", 
   RowBox[{"PlotLegends", "->", 
    RowBox[{"{", "\"\<\:6781\:70b9\>\"", "}"}]}]}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"h3", "[", "t_", "]"}], "=", 
  RowBox[{"InverseLaplaceTransform", "[", 
   RowBox[{
    RowBox[{"H3", "[", "s", "]"}], ",", "s", ",", "t"}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"c31", "=", 
  RowBox[{"Convolve", "[", 
   RowBox[{
    RowBox[{"h3", "[", "t", "]"}], ",", 
    RowBox[{"DiracDelta", "[", "t", "]"}], ",", "t", ",", "x"}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"c32", "=", 
  RowBox[{"Convolve", "[", 
   RowBox[{
    RowBox[{"h3", "[", "t", "]"}], ",", 
    RowBox[{"UnitStep", "[", "t", "]"}], ",", "t", ",", "x"}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"c31", ",", "c32"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"-", "9"}], ",", "9"}], "}"}]}], "]"}]}], "Input",
