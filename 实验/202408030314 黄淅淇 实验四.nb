Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Integrate", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"Abs", "[", 
     FractionBox[
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{"-", 
        FractionBox[
         RowBox[{"k", " ", 
          SuperscriptBox["x", "2"]}], 
         RowBox[{
          RowBox[{"b", " ", "k", " ", 
           SuperscriptBox["w", "2"]}], "+", 
          RowBox[{"2", " ", "\[ImaginaryI]", " ", "z"}]}]]}]], 
      RowBox[{
       SqrtBox[
        FractionBox["1", 
         RowBox[{"b", " ", 
          SuperscriptBox["w", "2"]}]]], " ", 
       SqrtBox[
        RowBox[{
         RowBox[{"b", " ", 
          SuperscriptBox["w", "2"]}], "+", 
         FractionBox[
          RowBox[{"2", " ", "\[ImaginaryI]", " ", "z"}], "k"]}]]}]], "]"}], 
    "^", "2"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"-", "Infinity"}], ",", "Infinity"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.8946974466362877`*^9, 3.8946975498526764`*^9}, {
   3.958166386044227*^9, 3.9581664009203396`*^9}, {3.958166473389124*^9, 
   3.9581664738791485`*^9}, 3.95816650940513*^9, {3.9581665433587103`*^9, 
   3.9581665434658775`*^9}},
 CellLabel->"In[57]:=",ExpressionUUID->"82063738-250d-4e20-9149-cf7c342c4a60"],

Cell[BoxData[
 TemplateBox[{
   FractionBox[
    SqrtBox[
     FractionBox["\[Pi]", "2"]], 
    RowBox[{
      RowBox[{"Abs", "[", 
        RowBox[{"1", "+", 
          FractionBox[
           RowBox[{"2", " ", "\[ImaginaryI]", " ", "z"}], 
           RowBox[{"b", " ", "k", " ", 
             SuperscriptBox["w", "2"]}]]}], "]"}], " ", 
      SqrtBox[
       RowBox[{"Re", "[", 
         FractionBox["k", 
          RowBox[{
            RowBox[{"b", " ", "k", " ", 
              SuperscriptBox["w", "2"]}], "+", 
            RowBox[{"2", " ", "\[ImaginaryI]", " ", "z"}]}]], "]"}]]}]], 
   RowBox[{
     RowBox[{"Re", "[", 
       FractionBox["k", 
        RowBox[{
          RowBox[{"b", " ", "k", " ", 
            SuperscriptBox["w", "2"]}], "+", 
          RowBox[{"2", " ", "\[ImaginaryI]", " ", "z"}]}]], "]"}], 
     "\[GreaterEqual]", "0"}]},
  "ConditionalExpression"]], "Output",
 CellChangeTimes->{
  3.958166481397113*^9, {3.958166530084128*^9, 3.958166552664042*^9}},
 CellLabel->"Out[57]=",ExpressionUUID->"3867a7a3-8aa1-4e7a-ac92-3fcf77f4ef4a"]
}, Open  ]],

