Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "4", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Clear", "[", "\"\<`*\>\"", "]"}], "\[IndentingNewLine]", 
   RowBox[{"A", "=", 
    RowBox[{"DSolve", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"I", " ", 
           RowBox[{"D", "[", 
            RowBox[{
             RowBox[{"u", "[", 
              RowBox[{"x", ",", "z"}], "]"}], ",", "z"}], "]"}]}], "+", 
          RowBox[{
           RowBox[{"1", "/", 
            RowBox[{"(", 
             RowBox[{"2", " ", "k"}], ")"}]}], 
           RowBox[{"D", "[", 
            RowBox[{
             RowBox[{"u", "[", 
              RowBox[{"x", ",", "z"}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"x", ",", "2"}], "}"}]}], "]"}]}]}], "\[Equal]", "0"}], 
        ",", 
        RowBox[{
         RowBox[{"u", "[", 
          RowBox[{"x", ",", "0"}], "]"}], "==", 
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"-", 
            RowBox[{"x", "^", "2"}]}], "/", 
           RowBox[{"(", 
            RowBox[{"b", " ", 
             RowBox[{"w", "^", "2"}]}], ")"}]}], "]"}]}]}], "}"}], ",", 
      RowBox[{"u", "[", 
       RowBox[{"x", ",", "z"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", "z"}], "}"}]}], "]"}]}]}]}]], "Input",
 CellChangeTimes->{{3.9581661130102644`*^9, 3.958166115804062*^9}, {
  3.958166176982622*^9, 3.958166199142188*^9}},
 CellLabel->"In[48]:=",ExpressionUUID->"71bd9791-6687-4799-85dd-762b80f62b82"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"u", "[", 
     RowBox[{"x", ",", "z"}], "]"}], "\[Rule]", 
    TemplateBox[{
      FractionBox[
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{"-", 
          FractionBox[
           RowBox[{"k", " ", 
             SuperscriptBox["x", "2"]}], 
           RowBox[{
             RowBox[{"b", " ", "k", " ", 
               SuperscriptBox["w", "2"]}], "+", 
             RowBox[{"2", " ", "\[ImaginaryI]", " ", "z"}]}]]}]], 
       RowBox[{
         SqrtBox[
          FractionBox["1", 
           RowBox[{"b", " ", 
             SuperscriptBox["w", "2"]}]]], " ", 
         SqrtBox[
          RowBox[{
            RowBox[{"b", " ", 
              SuperscriptBox["w", "2"]}], "+", 
            FractionBox[
             RowBox[{"2", " ", "\[ImaginaryI]", " ", "z"}], "k"]}]]}]], 
      RowBox[{
        RowBox[{"Re", "[", 
          RowBox[{"b", " ", 
            SuperscriptBox["w", "2"]}], "]"}], ">", 
        RowBox[{"2", " ", 
          RowBox[{"Im", "[", 
            FractionBox["z", "k"], "]"}]}]}]},
     "ConditionalExpression"]}], "}"}], "}"}]], "Output",
 CellChangeTimes->{3.9581662196285677`*^9},
 CellLabel->"Out[49]=",ExpressionUUID->"5aa7ee8f-d20a-4ee4-acb2-a0d4b53a1ba3"]
}, Open  ]],

