Cell[BoxData[{
 RowBox[{"Clear", "[", "\"\<'*\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"f", "[", "x_", "]"}], ":=", 
  RowBox[{"Which", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"-", "1"}], "/", "2"}], "\[LessEqual]", "x", "<", 
     RowBox[{"1", "/", "2"}]}], ",", 
    RowBox[{"1", "-", 
     RowBox[{"x", "^", "2"}]}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"f", "[", "x_", "]"}], ":=", 
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{"x", "-", "1"}], "]"}], "/;", 
   RowBox[{"x", "\[GreaterEqual]", 
    RowBox[{"1", "/", "2"}]}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"f", "[", "x_", "]"}], ":=", 
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{"x", "+", "1"}], "]"}], "/;", 
   RowBox[{"x", "<=", 
    RowBox[{
     RowBox[{"-", "1"}], "/", "2"}]}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"f5", "=", 
   RowBox[{"FourierSeries", "[", 
    RowBox[{
     RowBox[{"f", "[", "x", "]"}], ",", "x", ",", "5"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"f8", "=", 
   RowBox[{"FourierSeries", "[", 
    RowBox[{
     RowBox[{"f", "[", "x", "]"}], ",", "x", ",", "8"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
