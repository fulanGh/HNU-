Cell[BoxData[{
 RowBox[{"Clear", "[", "\"\<`*\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"f", "[", "x_", "]"}], ":=", 
  RowBox[{"Which", "[", 
   RowBox[{
    RowBox[{"0", "\[LessEqual]", "x", "\[LessEqual]", "2"}], ",", "x"}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"f", "[", "x_", "]"}], ":=", 
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{"x", "-", "2"}], "]"}], "/;", 
   RowBox[{"x", "\[GreaterEqual]", "2"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"f", "[", "x_", "]"}], ":=", 
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{"x", "+", "2"}], "]"}], "/;", 
   RowBox[{"x", "\[LessEqual]", "0"}]}]}], "\[IndentingNewLine]", 
 RowBox[{"f8", "=", 
  RowBox[{"FourierSeries", "[", 
   RowBox[{
    RowBox[{"f", "[", "x", "]"}], ",", "x", ",", "8"}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"f11", "=", 
  RowBox[{"FourierSeries", "[", 
   RowBox[{
    RowBox[{"f", "[", "x", "]"}], ",", "x", ",", "11"}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"f", "[", "x", "]"}], ",", "f8", ",", "f11"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"-", "3"}], ",", "3"}], "}"}], ",", 
   RowBox[{"PlotLegends", "\[Rule]", "\"\<Expressions\>\""}]}], 
  "]"}], "\[IndentingNewLine]"}], "Input",
