  RowBox[{
   RowBox[{"Clear", "[", "\"\<`*\>\"", "]"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"f1", "[", "w_", "]"}], ":=", 
    RowBox[{"Exp", "[", 
     RowBox[{"-", 
      RowBox[{"w", "^", "2"}]}], "]"}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"f2", "[", "w_", "]"}], ":=", 
    RowBox[{"Exp", "[", 
     RowBox[{
      RowBox[{"-", 
       SuperscriptBox["w", "2"]}], "+", 
      RowBox[{"I", " ", 
       SuperscriptBox["w", "2"]}]}], "]"}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"g", "[", "w_", "]"}], ":=", 
    RowBox[{"Exp", "[", 
     RowBox[{"I", " ", "2", " ", 
      RowBox[{"w", "^", "2"}], " ", 
      RowBox[{"z", "/", "2"}]}], "]"}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"f11", "[", 
     RowBox[{"z_", ",", "t_"}], "]"}], ":=", 
