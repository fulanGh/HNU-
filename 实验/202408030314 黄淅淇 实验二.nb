 RowBox[{"Clear", "[", "\"\<`*\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"f1", "[", "w_", "]"}], ":=", 
  RowBox[{"Exp", "[", 
   RowBox[{"-", 
    RowBox[{"w", "^", "2"}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"f2", "[", "w_", "]"}], ":=", 
  RowBox[{"Exp", "[", 
   RowBox[{
    RowBox[{"-", 
     SuperscriptBox["w", "2"]}], "+", 
    RowBox[{"I", " ", 
     SuperscriptBox["w", "2"]}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"g", "[", "w_", "]"}], ":=", 
  RowBox[{"Exp", "[", 
   RowBox[{"I", " ", "4", " ", 
    RowBox[{"w", "^", "2"}], " ", 
    RowBox[{"z", "/", 
     RowBox[{"Factorial", "[", "4", "]"}]}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"f11", "[", 
   RowBox[{"z_", ",", "t_"}], "]"}], ":=", 
  RowBox[{"InverseFourierTransform", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"f1", "[", "w", "]"}], " ", 
     RowBox[{"g", "[", "w", "]"}]}], ",", "w", ",", "t"}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"f12", "[", 
   RowBox[{"z_", ",", "t_"}], "]"}], ":=", 
  RowBox[{"InverseFourierTransform", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"f2", "[", "w", "]"}], " ", 
     RowBox[{"g", "[", "w", "]"}]}], ",", "w", ",", "t"}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"Plot3D", "[", 
  RowBox[{
   RowBox[{"Abs", "[", 
    RowBox[{"f11", "[", 
     RowBox[{"z", ",", "t"}], "]"}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", 
     RowBox[{"-", "10"}], ",", "10"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"z", ",", 
     RowBox[{"-", "10"}], ",", "10"}], "}"}], ",", 
   RowBox[{"PlotRange", "\[Rule]", "All"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"Plot3D", "[", 
  RowBox[{
   RowBox[{"Abs", "[", 
    RowBox[{"f12", "[", 
     RowBox[{"z", ",", "t"}], "]"}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", 
     RowBox[{"-", "10"}], ",", "10"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"z", ",", 
     RowBox[{"-", "10"}], ",", "10"}], "}"}], ",", 
   RowBox[{"PlotRange", "\[Rule]", "All"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.9570573560316906`*^9, 3.957057358985944*^9}},
 CellLabel->
  "In[433]:=",ExpressionUUID->"cdc0f00b-12a8-41f6-ad22-86d97c2d8650"],

