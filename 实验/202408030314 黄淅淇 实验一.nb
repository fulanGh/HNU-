Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"u", "[", "t_", "]"}], ":=", 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{"Exp", "[", 
      RowBox[{"I", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"1000", " ", "Pi"}], "+", 
         RowBox[{"n", " ", "Pi"}]}], ")"}], "t"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"n", ",", 
       RowBox[{"-", "5"}], ",", "5"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   SuperscriptBox[
    RowBox[{"Abs", "[", 
     RowBox[{"u", "[", "t", "]"}], "]"}], "2"], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", 
     RowBox[{"-", "3"}], ",", "3"}], "}"}], ",", 
   RowBox[{"PlotRange", "->", "All"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"Arg", "[", 
    RowBox[{"u", "[", "t", "]"}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", 
     RowBox[{"-", "0.1"}], ",", "0.1"}], "}"}], ",", 
   RowBox[{"PlotRange", "->", "All"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.9563516222979174`*^9, 3.956351623650725*^9}, {
  3.956352158817047*^9, 3.956352316269966*^9}},
 CellLabel->
  "In[100]:=",ExpressionUUID->"595ab13c-ad90-4dad-a77e-62467e472014"],

